{
  "name": "nudle-room-application",
  "version": "0.1.0",
  "private": true,
  "description": "Nudle Room Application",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "npm-run-all build:*",
    "build:tsc": "tsc -b",
    "build:vite": "vite build --emptyOutDir",
    "dev": "npm-run-all --parallel dev:*",
    "dev:vite": "vite",
    "lint": "eslint .",
    "prepare": "husky",
    "prettier:check": "prettier --check .",
    "prettier:format": "prettier --write .",
    "preview": "vite preview",
    "start": "vite",
    "test": "npm run watch:test",
    "test:coverage": "vitest run --coverage",
    "watch": "npm-run-all --parallel watch:*",
    "watch:test": "vitest --",
    "watch:tsc": "tsc --noEmit --watch"
  },
  "dependencies": {
    "piqure": "2.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@prettier/plugin-xml": "3.4.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@tsconfig/vite-react": "8.1.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-istanbul": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.4",
    "prettier": "3.9.10",
    "prettier-plugin-gherkin": "4.0.0",
    "prettier-plugin-java": "2.11.0",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-sonar-reporter": "3.0.0"
  },
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=24"
  }
}
